# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- LLM (NEAR AI Cloud is the primary provider) ---
NEAR_AI_API_KEY=
# NEAR_AI_MODEL=anthropic/claude-haiku-5-5

# Optional fallbacks, used in this order if the previous one fails (override with LLM_ORDER=claude,near)
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# LLM_ORDER=near

# --- Speech-to-text (first available is used: GROQ_API_KEY, OPENAI_API_KEY, STT_URL, else NEAR AI whisper) ---
# STT_URL=
# STT_KEY=
# STT_MODEL=whisper-large-v3-turbo
STT_LANG=en

# --- Money: NEAR Intents 1Click API (JWT from the NEAR Intents partner dashboard) ---
ONECLICK_JWT=

# --- Web search tool ---
TAVILY_API_KEY=

# --- Server ---
PORT=8899
# Public URL when the server is exposed through a tunnel (used for phone pages and QR codes)
# PUBLIC_URL=https://nib.example.com
# Shared secret the device sends as `x-nib-key` over the tunnel. Generate: openssl rand -hex 24
NIB_DEVICE_KEY=
# HOME_CITY=Belgrade
